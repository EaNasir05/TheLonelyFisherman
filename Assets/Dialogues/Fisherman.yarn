title: Start
position: 12,12
---
<<declare $Affection = 0>>
<<declare $posValue = 0>>
<<declare $negValue = 0>>
<<declare $lastChoiceGood = true>> // ultima scelta: true = A, false = B
<<declare $dayIndex = 0>> //Variabile che controlla il giorno corrente
<<declare $boatBuilt = false>> //Variabile che controlla se la è barca finita
<<declare $letterDone = false>> //Variabile che controlla se la scena di non ritorno è già avvenuta.
<<declare $visitIndex = 2>>
<<declare $confirm = false>> //Variabile per i nodi degli interagibili
<<declare $boatCost = 0>>
<<declare $boatUpgradable = false>>
===

title: Morning
position: 107,792
---
// Check finali barca
<<if $boatBuilt and $letterDone>>
    <<jump Finale>>
<<elseif $boatBuilt>>
    <<jump VisitLettera>>

// Giorni 1-12
<<elseif $dayIndex == 1>>
    <<jump Day1>>
<<elseif $dayIndex == 2>>
    <<jump Day2>>
<<elseif $dayIndex == 3>>
    <<jump Day3>>
<<elseif $dayIndex == 4>>
    <<jump Day4>>
<<elseif $dayIndex == 5>>
    <<jump Day5>>
<<elseif $dayIndex == 6>>
    <<jump Day6>>
<<elseif $dayIndex == 7>>
    <<jump Day7>>
<<elseif $dayIndex == 8>>
    <<jump Day8>>
<<elseif $dayIndex == 9>>
    <<jump Day9>>
<<elseif $dayIndex == 10>>
    <<jump Day10>>
<<elseif $dayIndex == 11>>
    <<jump Day11>>
<<elseif $dayIndex == 12>>
    <<jump Day12>>

// Giorno 13 (affezione negativa)
<<elseif $dayIndex == 13 and not $letterDone and $Affection <= -5>>
    <<jump VisitLettera>>
<<elseif $dayIndex == 13 and $Affection <= 0>>
    <<jump Visit13>>
<<elseif $dayIndex == 13>>
    <<jump Day13>>

<<elseif $dayIndex == 14>>
    <<jump Day14>>

// Giorno 15 (affezione positiva)
<<elseif $dayIndex == 15 and not $letterDone and $Affection >= 5>>
    <<jump VisitLettera>>
<<elseif $dayIndex == 15 and not $letterDone and not visited("Visit13") and $Affection > 0>>
    <<jump Visit15>>
<<elseif $dayIndex == 15>>
    <<jump Day15>>

// Giorno 16 (solo dopo la visita 6 del giorno 13)
<<elseif $dayIndex == 16 and not $letterDone and $Affection <= -5>>
    <<jump VisitLettera>>
<<elseif $dayIndex == 16 and not $letterDone and visited("Visit13") and $Affection <= 0>>
    <<jump Visit16>>
<<elseif $dayIndex == 16>>
    <<jump Day16>>

<<elseif $dayIndex == 17>>
    <<jump Day17>>
<<elseif $dayIndex == 18>>
    <<jump Day18>>

// Giorno 19 lettera con valori intermedi
<<elseif $dayIndex == 19 and not $letterDone>>
    <<jump VisitLettera>>
<<elseif $dayIndex == 19>>
    <<jump Day19>>

<<elseif $dayIndex == 20>>
    <<jump Day20>>
<<elseif $dayIndex == 21>>
    <<jump Day21>>
<<elseif $dayIndex == 22>>
    <<jump Day22>>
<<elseif $dayIndex == 23>>
    <<jump Day23>>

// Giorno 24 (solo affezione positiva)
<<elseif $dayIndex == 24 and $letterDone and $Affection > 0>>
    <<jump Visit24>>
<<elseif $dayIndex == 24>>
    <<jump Day24>>

<<elseif $dayIndex == 25>>
    <<jump Day25>>
<<elseif $dayIndex == 26>>
    <<jump Day26>>
<<elseif $dayIndex == 27>>
    <<jump Day27>>
<<elseif $dayIndex == 28>>
    <<jump Day28>>
<<elseif $dayIndex == 29>>
    <<jump Day29>>

// Finali
<<else>>
    <<jump Finale>>
<<endif>>
===

